#!/bin/bash
#
# Print which device the live ISO booted from and which I/O scheduler it is
# on. Run by omarchy-root-image-verify.service before the hash so the answer
# sits next to the verify result in `systemctl status` and the journal: the
# unit's IOSchedulingClass=idle only means something under bfq, which
# 71-omarchy-iso-boot-medium-bfq.rules is supposed to have set by now.

set -euo pipefail

mount=/run/archiso/bootmnt
source=$(findmnt -no SOURCE "$mount" 2>/dev/null || true)
if [[ -z $source ]]; then
  echo "boot medium: $mount is not mounted"
  exit 0
fi

disk=$(lsblk -no PKNAME "$source" 2>/dev/null | head -n1)
[[ -n $disk ]] || disk=${source#/dev/}

scheduler="unknown"
if [[ -r /sys/block/$disk/queue/scheduler ]]; then
  scheduler=$(cat "/sys/block/$disk/queue/scheduler")
fi

echo "boot medium: $source on /dev/$disk, scheduler: $scheduler"
